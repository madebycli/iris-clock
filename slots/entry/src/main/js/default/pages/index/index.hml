<div class="page" onswipe="swipe" onrotation="crown">
    <text class="credits">{{credits}} Credits</text>
    <div class="machine">
        <div class="payline {{flash ? 'payline-on' : ''}}"></div>
        <div class="reel">
            <image class="sym dim" src="{{r0[0]}}"></image>
            <image class="sym" src="{{r0[1]}}"></image>
            <image class="sym dim" src="{{r0[2]}}"></image>
        </div>
        <div class="reel">
            <image class="sym dim" src="{{r1[0]}}"></image>
            <image class="sym" src="{{r1[1]}}"></image>
            <image class="sym dim" src="{{r1[2]}}"></image>
        </div>
        <div class="reel">
            <image class="sym dim" src="{{r2[0]}}"></image>
            <image class="sym" src="{{r2[1]}}"></image>
            <image class="sym dim" src="{{r2[2]}}"></image>
        </div>
    </div>
    <text class="say {{tier}} {{flash ? 'say-on' : ''}}">{{message}}</text>
    <input type="button" class="lever {{spinning ? 'lever-busy' : ''}}" value="{{button}}" onclick="pull"></input>
    <text class="nav">◀ Hilfe · Stats ▶ · ▲ Verlauf</text>
</div>
